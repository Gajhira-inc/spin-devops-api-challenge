# Local-only setup. Do not commit .env or real credentials.
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://spin_local:spin_local@localhost:5432/spin
DB_SSLMODE=disable
PROVIDER_BASE_URL=http://localhost:8001
PROVIDER_ALLOW_HTTP=true
PROVIDER_TIMEOUT=3
DOCS_ENABLED=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
# Optional local auth; production requires >=32 characters from an external secret.
# API_BEARER_TOKEN=replace-with-a-random-local-token
